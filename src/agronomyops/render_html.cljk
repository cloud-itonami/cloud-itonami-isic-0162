(ns agronomyops.render-html
  "Build-time HTML renderer for `docs/samples/operator-console.html`.

  Closes flagship checklist item 2 (com-junkawasaki/root ADR-2607189300,
  Wave5). Drives the REAL actor stack (`agronomyops.operation` ->
  `agronomyops.governor` -> `agronomyops.store`) through a scenario adapted
  from this repo's own `agronomyops.sim` demo driver, rendered
  deterministically -- no invented numbers/ids/ops.

  Usage: `kbb -M:dev:render-html [out-file]`."
  (:require [kotoba.lang.text :as str]
            [agronomyops.store :as store]
            [agronomyops.operation :as op]
            [langgraph.graph :as g]))

(def ^:private operator {:actor-id "op-1" :actor-role :agronomy-operator :phase 3})

(defn- exec! [actor tid request]
  (g/run* actor {:request request :context operator} {:thread-id tid}))
(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "op-1"}} {:thread-id tid :resume? true}))

(defn run-demo!
  "Seeds the visit directory then runs a representative mix: visit-1's full
  clean lifecycle (intake auto-commit, jurisdiction/sample/treatment each
  human-approved), plus two HARD holds -- a jurisdiction assessment with no
  spec basis (visit-2) and a double-sample attempt on an already-sampled
  visit (visit-1). Every id/op is from agronomyops.sim / governor / store."
  []
  (let [db (store/seed-db)
        actor (op/build db)]
    (exec! actor "t1" {:op :visit/intake :subject "visit-1"
                       :patch {:id "visit-1" :farm "Kita Farm"}})
    (exec! actor "t2" {:op :jurisdiction/assess :subject "visit-1"})
    (approve! actor "t2")
    (exec! actor "t3" {:op :sample/collect :subject "visit-1"})
    (approve! actor "t3")
    (exec! actor "t4" {:op :treatment/apply :subject "visit-1"})
    (approve! actor "t4")
    (exec! actor "t5" {:op :jurisdiction/assess :subject "visit-2" :no-spec? true})
    (exec! actor "t6" {:op :sample/collect :subject "visit-1"})
    db))

;; ----------------------------- rendering -----------------------------

(defn- esc [v]
  (-> (str v)
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")))

(defn- last-fact-for [ledger vid]
  (last (filter #(= (:subject %) vid) ledger)))

(defn- status-cell [ledger vid]
  (let [f (last-fact-for ledger vid)]
    (cond
      (nil? f) "<span class=\"muted\">no activity</span>"
      (= :committed (:t f)) "<span class=\"ok\">committed</span>"
      (= :approval-granted (:t f)) "<span class=\"ok\">approved &amp; committed</span>"
      (= :governor-hold (:t f))
      (let [rule (-> f :basis first)]
        (str "<span class=\"critical\">HARD hold &middot; " (esc (name (or rule :unknown))) "</span>"))
      (= :approval-requested (:t f)) "<span class=\"warn\">awaiting approval</span>"
      :else "<span class=\"muted\">in progress</span>")))

(defn- visit-row [ledger v]
  (format "        <tr><td>%s</td><td>%s</td><td>%s</td></tr>"
          (esc (:id v)) (esc (or (:farm v) "—")) (status-cell ledger (:id v))))

(defn- ledger-row [{:keys [t op subject disposition basis]}]
  (format "        <tr><td>%s</td><td><code>%s</code></td><td>%s</td><td>%s</td></tr>"
          (esc (name t)) (esc (name (or op :n-a))) (esc subject)
          (esc (or (some->> basis (map name) (str/join ", ")) (some-> disposition name) ""))))

(def ^:private action-gate-rows
  ["        <tr><td><code>:visit/intake</code></td><td><span class=\"ok\">auto-commit when clean</span></td></tr>"
   "        <tr><td><code>:jurisdiction/assess</code></td><td><span class=\"warn\">ALWAYS human approval; spec-basis required</span></td></tr>"
   "        <tr><td><code>:sample/collect</code></td><td><span class=\"warn\">ALWAYS human approval; double-sampling HARD-blocked</span></td></tr>"
   "        <tr><td><code>:treatment/apply</code></td><td><span class=\"warn\">ALWAYS human approval; dose recompute + product/ water-buffer checks</span></td></tr>"])

(defn render [db]
  (let [ledger (vec (store/ledger db))
        visits (->> (store/all-visits db)
                    (filter #(#{"visit-1" "visit-2"} (:id %)))
                    (sort-by :id))
        visit-rows (str/join "\n" (map (partial visit-row ledger) visits))
        ledger-rows (str/join "\n" (map ledger-row ledger))]
    (str
     "<html><head><meta charset=\"utf-8\"><title>cloud-itonami-isic-0162 &middot; agronomy field ops</title><style>"
     "body{font:14px/1.5 -apple-system,system-ui,sans-serif;margin:0;color:#1a1a1a;background:#f5f5f5}"
     ".bar{background:#1a3a2a;color:#fff;padding:1.2rem 2rem}.bar h1{margin:0;font-size:1.15rem;font-weight:600}"
     ".badge{display:inline-block;margin-top:.4rem;font-size:.75rem;opacity:.8}"
     "main{max-width:980px;margin:1.5rem auto;padding:0 1rem}"
     ".card{background:#fff;border-radius:8px;padding:1.2rem 1.4rem;margin-bottom:1.2rem;box-shadow:0 1px 3px rgba(0,0,0,.08)}"
     ".card h2{margin-top:0;font-size:1rem}.muted{color:#777;font-size:.82rem}"
     "table{border-collapse:collapse;width:100%;font-size:.85rem}th,td{text-align:left;padding:.42rem .5rem;border-bottom:1px solid #eee}th{font-weight:600;color:#555}"
     ".ok{color:#0a7d33}.warn{color:#9a6700}.critical{color:#b41010;font-weight:600}code{background:#f0f0f0;padding:.1rem .3rem;border-radius:3px;font-size:.8rem}"
     "</style></head><body>\n"
     "<header class=\"bar\">\n  <h1>Agronomy field ops (ISIC 0162) — Operator Console</h1>\n"
     "  <span class=\"badge\">read-only sample · governor-gated · jurisdiction/sample/treatment always human-approved · dose-recompute + product + water-buffer checks</span>\n</header>\n"
     "<main>\n  <section class=\"card\">\n    <h2>Scenario visits</h2>\n"
     "    <p class=\"muted\">Demo snapshot — build-time-generated from <code>agronomyops.store</code> via <code>agronomyops.render-html</code> (<code>kbb -M:dev:render-html</code>), regenerated nightly. No invented data.</p>\n"
     "    <table>\n      <thead><tr><th>Visit</th><th>Farm</th><th>Last op status</th></tr></thead>\n      <tbody>\n"
     visit-rows "\n      </tbody>\n    </table>\n  </section>\n"
     "  <section class=\"card\">\n    <h2>Action gate (Agronomy Governor)</h2>\n"
     "    <p class=\"muted\">HARD holds cannot be overridden. Treatment doses are independently recomputed (never trusted from the proposal); products must be approved for the crop; water-source buffer compliance is verified.</p>\n"
     "    <table>\n      <thead><tr><th>Op</th><th>Gate</th></tr></thead>\n      <tbody>\n"
     (str/join "\n" action-gate-rows) "\n      </tbody>\n    </table>\n  </section>\n"
     "  <section class=\"card\">\n    <h2>Audit ledger (this run)</h2>\n"
     "    <p class=\"muted\">Append-only decision-fact log — every proposal, hold and commit this scenario produced.</p>\n"
     "    <table>\n      <thead><tr><th>Fact</th><th>Op</th><th>Subject</th><th>Basis</th></tr></thead>\n      <tbody>\n"
     ledger-rows "\n      </tbody>\n    </table>\n  </section>\n"
     "</main>\n</body></html>\n")))

(defn -main [& args]
  (let [out (or (first args) "docs/samples/operator-console.html")
        db (run-demo!)
        out-file (java.io.File. out)]
    (.. out-file getParentFile mkdirs)
    (spit out-file (render db))
    (println "wrote" out "(" (count (store/ledger db)) "ledger facts )")))
